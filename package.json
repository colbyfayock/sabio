{
  "name": "sabio",
  "version": "0.0.0",
  "private": true,
  "description": "An owner-controlled dashboard for approved displays",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "wrangler": "wrangler",
    "types": "wrangler types",
    "typecheck": "pnpm types && tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && wrangler dev --local --ip 127.0.0.1 --inspector-ip 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "build:worker": "pnpm build && wrangler deploy --dry-run --outdir build/worker"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
