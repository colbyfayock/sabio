{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sabio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_MODE": "preview",
    "APP_ORIGIN": "",
    "APP_ALLOWED_ORIGINS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUDIENCE": "",
    "OWNER_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sabio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.01
    }
  }
}
